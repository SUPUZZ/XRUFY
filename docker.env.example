# 复制为 docker.env 后由 docker compose 读取（勿提交 docker.env）
#   copy docker.env.example docker.env
#
# 与 docker-compose 默认一致；若你能直连 Docker Hub，可改为 postgres:16-alpine / node:22-alpine
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine

POSTGRES_USER=xrufy
POSTGRES_PASSWORD=xrufy
POSTGRES_DB=xrufy

# 映射到本机端口；默认 5433 避免与 Windows 自带 PostgreSQL 的 5432 冲突
POSTGRES_PUBLISH_PORT=5433

WEB_PORT=3000

# 容器开发 npm run docker:dev：默认主机 3001→容器 3000、4001→4000；若要占满 3000/4000 且本机空闲可写：
# DEV_WEB_PORT=3000
# DEV_API_PORT=4000

# 可选：https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# 管理后台 /admin 登录密码（务必改成强密码，勿提交真实 docker.env）
ADMIN_PASSWORD=change-me-admin
# 可选：会话签名密钥；不填则用 ADMIN_PASSWORD 派生（生产建议单独长随机串）
# ADMIN_SESSION_SECRET=
