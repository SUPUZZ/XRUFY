# Public site URL (no trailing slash) — used for canonical, Open Graph, and JSON-LD.
# Production (brand domain):
# NEXT_PUBLIC_SITE_URL=https://xrufy.com

# Multi-brand feedback API base URL.
NEXT_PUBLIC_FEEDBACK_API_BASE_URL=https://api.supuzz.cn

# Tenant identity for feedback/subscribe API.
NEXT_PUBLIC_FEEDBACK_BRAND_NAME=xrufy

# Optional: if empty, frontend uses window.location.hostname.
# NEXT_PUBLIC_FEEDBACK_DOMAIN=www.xrufy.com

# Optional: GitHub Pages repo path, e.g. /XRUFY-web
# NEXT_PUBLIC_BASE_PATH=/XRUFY-web

# Dev only: allow LAN/browser origin for Next.js dev resources, e.g. http://192.168.11.48:3000
# NEXT_ALLOWED_DEV_ORIGINS=http://192.168.11.48:3000
