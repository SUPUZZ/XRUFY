# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js (web app)
web/.next/
web/out/

# local PostgreSQL data (pg_ctl on port 5433, see server/.env)
.pgdata-local/

# server build
server/dist/

# server runtime logs (JSON lines — do not commit)
server/logs/

# local newsletter captures (file fallback — do not commit)
server/data/*.jsonl

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
