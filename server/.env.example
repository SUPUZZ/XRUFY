# XRUFY API — copy to server/.env

# PostgreSQL (required for saving form rows). Local Docker example:
#   docker compose up -d   (from repo root)
#   npm run db:push -w @xrufy/server
#
# Windows 本机 (winget install PostgreSQL.PostgreSQL.16 等)：完成安装向导、确保服务已启动后，
# 用安装时设置的 postgres 密码，在「SQL Shell (psql)」或命令行执行:
#   CREATE USER xrufy WITH PASSWORD 'xrufy';
#   CREATE DATABASE xrufy OWNER xrufy;
# 然后在本仓库根目录: npm run db:push
#
# 若 5432 已被系统 PostgreSQL 占用、又不想改密码：可用仓库内独立数据目录（端口 5433）：
#   initdb -D .pgdata-local -U postgres -A trust -E UTF8 --locale=C
#   npm run db:local-pg:start
#   （用 psql -h 127.0.0.1 -p 5433 -U postgres 执行上面的 CREATE USER / DATABASE）
#   DATABASE_URL=postgresql://xrufy:xrufy@127.0.0.1:5433/xrufy
#   npm run db:push
DATABASE_URL=postgresql://xrufy:xrufy@127.0.0.1:5432/xrufy

# 若数据库只用根目录 Docker 启动（默认把 Postgres 映射到本机 5433）：
# DATABASE_URL=postgresql://xrufy:xrufy@127.0.0.1:5433/xrufy

# ─── If GET /health returns database "error" ─────────────────────────────
# • code 28P01: wrong user/password. Common on Windows when 5432 is already a
#   system PostgreSQL (not Docker). Fix one of:
#   1) In psql as superuser: CREATE USER xrufy WITH PASSWORD 'xrufy';
#      CREATE DATABASE xrufy OWNER xrufy;  then npm run db:push -w @xrufy/server
#   2) Or install Docker, change docker-compose.yml ports to "5434:5432" to avoid
#      clashing with local PG, docker compose up -d, set DATABASE_URL port 5434.
#   3) Or remove DATABASE_URL from server/.env — API runs with database "disabled"
#      (forms still work via Web3Forms or newsletter jsonl fallback).
# • code ECONNREFUSED: no server on that host:port — start Postgres or fix URL.

# Email delivery via https://web3forms.com (optional)
WEB3FORMS_ACCESS_KEY=

# 管理后台（浏览器打开站点 /admin，API 校验密码）
# 本地 dev：与 Next 同机时设置后重启 npm run dev
ADMIN_PASSWORD=change-me-admin
# 可选：签发 Cookie 用；不填则从 ADMIN_PASSWORD 派生
# ADMIN_SESSION_SECRET=

# If both DATABASE_URL and WEB3FORMS are empty, newsletter signups are still saved to:
#   server/data/newsletter-signups.jsonl

# Dev: `npm run dev` (repo root) runs predev and frees TCP 4000 so API can start. Manual: npm run server:kill
# If you must share 4000 with another app, set e.g. PORT=4001 and point Next at it: SERVER_ORIGIN=http://127.0.0.1:4001

# Optional (default 4000)
# PORT=4000

# ─── Logging (Pino, JSON lines) ───────────────────────────────────────────
# Every line is one JSON object: grep / jq friendly. Default file: server/logs/app.jsonl
# LOG_LEVEL=info
# LOG_FILE=logs/custom.jsonl
# LOG_DISABLE_FILE=1

# Optional: allow browser fetch directly to API. Comma-separated.
# CORS_ORIGINS=http://localhost:3000
