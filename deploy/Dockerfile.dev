# 开发：单容器内跑 web + server（挂载源码，依赖同 compose 里的 postgres）
ARG BASE_NODE=docker.m.daocloud.io/library/node:22-alpine
FROM ${BASE_NODE}
WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY deploy/docker-dev-entrypoint.sh /usr/local/bin/docker-dev-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-dev-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-dev-entrypoint.sh"]
