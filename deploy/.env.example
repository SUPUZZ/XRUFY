# Copy to .env next to docker-compose.yml:  cp .env.example .env

# PostgreSQL (used by postgres service + DATABASE_URL for api)
POSTGRES_USER=xrufy
# Use letters/numbers if possible; if you use @ : # etc., URL-encode in manual DATABASE_URL tools.
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=xrufy

# Host port mapped to Next.js (inside stack, web still listens on 3000)
WEB_PORT=3000

# Optional: https://web3forms.com — if empty, forms still save to DB when DATABASE_URL works
WEB3FORMS_ACCESS_KEY=
